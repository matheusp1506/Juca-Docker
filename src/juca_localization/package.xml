<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>juca_localization</name>
    <version>0.1.0</version>
    <description>Self-contained localization and simulation package for Juca</description>
    <maintainer email="matheusp1506@gmail.com">Matheus Pereira</maintainer>
    <license>Apache-2.0</license>

    <exec_depend>rclpy</exec_depend>
    <exec_depend>nav_msgs</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>robot_localization</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>ros_gz_bridge</exec_depend>
    <exec_depend>ros_gz_sim</exec_depend>
    <exec_depend>micro_ros_agent</exec_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>
